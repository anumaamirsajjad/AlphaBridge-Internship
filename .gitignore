# Local virtual environment (Windows-specific).
api/.venv/

# Python and test caches (generated automatically).
__pycache__/
.pytest_cache/

# Local secrets. Never commit real passwords or API keys.
.env
# Test coverage report (generated by pytest-cov).
api/.coverage

# Generated data file (created by a script, not written by hand).
api/pending-ids-5000.js

# Terraform working files. The state lives in S3, never in Git. The lock file
# (.terraform.lock.hcl) is committed on purpose, so every run uses the same provider versions.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/crash.log
infra/*.tfplan
